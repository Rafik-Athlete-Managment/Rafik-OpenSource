{
  "expo": {
    "name": "Rafik Field",
    "slug": "rafik-field",
    "version": "1.0.0-beta.3",
    "orientation": "default",
    "scheme": "rafik",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.rafik.field",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "versionCode": 1000003
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/android-icons/mipmap-xxxhdpi/ic_launcher.png"
  }
}
