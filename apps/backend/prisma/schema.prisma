generator client {
  provider        = "prisma-client"
  output          = "../server/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model password_setup_tokens {
  token_hash   String   @id
  user_id      String   @db.Uuid
  institution_id String   @db.Uuid
  created_by   String   @db.Uuid
  expires_at   DateTime @db.Timestamptz(6)

  user      users      @relation("password_setup_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issuer    users      @relation("password_setup_issuer", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  institution institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "password_setup_tokens_user_expiry")
  @@schema("identity")
}

model rate_limits {
  key          String   @id
  count        Int      @default(1)
  window_start DateTime @default(now()) @db.Timestamptz(6)

  @@schema("identity")
}

model identity_sessions {
  token_hash   String   @id
  user_id      String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "sessions_user")
  @@map("sessions")
  @@schema("identity")
}

model mobile_sessions {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     String    @db.Uuid
  access_token_hash           String    @unique
  refresh_token_hash          String    @unique
  previous_refresh_token_hash String?   @unique
  access_expires_at           DateTime  @db.Timestamptz(6)
  expires_at                  DateTime  @db.Timestamptz(6)
  absolute_expires_at         DateTime  @db.Timestamptz(6)
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at                DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at                  DateTime? @db.Timestamptz(6)
  device_name                 String    @default("Android device")
  users                       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "mobile_sessions_user_active", where: raw("(revoked_at IS NULL)"))
  @@schema("identity")
}

model users {
  id                                                             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                          String?                  @unique
  email_confirmed_at                                             DateTime?                @db.Timestamptz(6)
  password_hash                                                  String?
  raw_user_meta_data                                             Json                     @default("{}")
  created_at                                                     DateTime                 @default(now()) @db.Timestamptz(6)
  sessions                                                       identity_sessions[]
  mobile_sessions                                                mobile_sessions[]
  platform_grants                                                platform_grants?
  platform_identity_state                                        platform_identity_state?
  platform_operations                                            platform_operations[]
  profiles                                                       profiles?
  program_media                                                  program_media[]
  institution_audit_events                                               institution_audit_events[]
  institution_invitations_institution_invitations_accepted_byTousers institution_invitations[]  @relation("institution_invitations_accepted_byTousers")
  institution_invitations_institution_invitations_created_byTousers  institution_invitations[]  @relation("institution_invitations_created_byTousers")
  institution_members                                              institution_members[]
  institution_operations                                           institution_operations[]
  institutions                                                     institutions[]
  instance_branding                                              instance_branding?
  password_setup_subject                                         password_setup_tokens[]  @relation("password_setup_user")
  password_setup_issued                                          password_setup_tokens[]  @relation("password_setup_issuer")

  @@schema("identity")
}

