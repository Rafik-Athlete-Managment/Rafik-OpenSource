  institution_programs    institution_programs      @relation(fields: [institution_id, program_id], references: [institution_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([program_id, revision])
  @@unique([institution_id, id])
  @@schema("public")
}

