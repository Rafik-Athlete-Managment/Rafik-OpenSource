model institution_sessions {
  source_kind String @default("assignment")
  id                            String                         @id @db.Uuid
  institution_id                  String                         @db.Uuid
  member_id                     String                         @db.Uuid
  assignment_id                 String?                         @db.Uuid
  day_id                        String
  local_date                    DateTime                       @db.Date
  document                      Json
  version                       Int                            @default(1)
  started_at                    DateTime                       @default(now()) @db.Timestamptz(6)
  completed_at                  DateTime?                      @db.Timestamptz(6)
  institution_session_feedback institution_session_feedback?
  institution_assignments      institution_assignments?       @relation(fields: [institution_id, assignment_id], references: [institution_id, id], onDelete: NoAction, onUpdate: NoAction)
  institutions                    institutions                     @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  institution_members             institution_members              @relation(fields: [institution_id, member_id], references: [institution_id, id], onDelete: NoAction, onUpdate: NoAction)

  recorded_mode                  String                          @default("self")
  recorded_by                    String?                         @db.Uuid
  recorder                       institution_members?              @relation("session_recorder", fields: [institution_id, recorded_by], references: [institution_id, id], onDelete: NoAction, onUpdate: NoAction, map: "institution_sessions_recorded_by")
  institution_session_history   institution_session_history[]
  occurrence_id                  String?                         @db.Uuid
  source_snapshot                Json?
  institution_event_people      institution_event_people?      @relation(fields: [institution_id, member_id, occurrence_id], references: [institution_id, member_id, event_id], onDelete: NoAction, onUpdate: NoAction, map: "institution_workout_participant")
  institution_workout_positions institution_workout_positions?

  @@unique([assignment_id, local_date, day_id])
  @@unique([institution_id, id])
  @@unique([institution_id, member_id, id], map: "institution_session_subject")
  @@unique([institution_id, member_id, occurrence_id], map: "institution_workout_scoped_participant")
  @@unique([occurrence_id, member_id], map: "institution_workout_occurrence_subject", where: raw("(occurrence_id IS NOT NULL)"))
  @@index([institution_id, member_id, started_at(sort: Desc), id], map: "institution_history")
  @@schema("public")
}

model institution_versions {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id             String                     @db.Uuid
  program_id               String                     @db.Uuid
  revision                 Int
  title                    String
  prescription             Json
