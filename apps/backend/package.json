{
  "name": "@rafik/backend",
  "version": "1.0.0-beta.2",
  "private": true,
  "scarfSettings": {
    "enabled": false
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node scripts/prisma/local.mjs start",
    "stop": "node scripts/prisma/local.mjs stop",
    "test": "node scripts/prisma/local.mjs test",
    "types": "tsx scripts/prisma/types.ts",
    "web-env": "node scripts/prisma/local.mjs web-env",
    "content": "node scripts/content.mjs",
    "content:check": "node scripts/content.mjs --check",
    "test:fresh": "node scripts/prisma/fresh.mjs",
    "support:local": "node scripts/support-local.mjs",
    "test:docs": "node --test --test-isolation=none scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:release": "node --test scripts/release-guard.test.mjs",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../../infrastructure/compose.yaml --profile local up -d --wait",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed:local": "node scripts/prisma/local.mjs seed",
    "test:api": "node scripts/prisma/isolated-api.mjs tests/api.test.ts",
    "test:api-docs": "tsx --test tests/api-docs.test.ts",
    "test:organizations": "node scripts/prisma/isolated-api.mjs tests/institution-access.test.ts",
    "test:programming": "node scripts/prisma/isolated-api.mjs tests/programming.test.ts tests/program-media.test.ts",
    "test:organization-services": "node scripts/prisma/isolated-api.mjs tests/organization-services.test.ts",
    "test:communication": "node scripts/prisma/isolated-api.mjs tests/communication.test.ts tests/notifications.test.ts",
    "notifications:local": "tsx scripts/dispatch-notifications.ts",
    "test:operations": "node --test --test-isolation=none scripts/prisma/local-storage-target.test.mjs && node scripts/prisma/isolated-api.mjs tests/platform.test.ts tests/scale.test.ts tests/maintenance.test.ts tests/local-boundary.test.ts",
    "recovery:local": "node scripts/prisma/recovery.mjs",
    "files:maintenance": "node scripts/prisma/cleanup-private.mjs",
    "test:catalog": "node scripts/prisma/isolated-api.mjs tests/public-catalog.test.ts tests/exercise-video.test.ts",
    "content:media": "node scripts/content/exercise-media.mjs",
    "content:exercise-dataset": "node scripts/content/exercise-dataset.mjs",
    "content:exercise-dataset:check": "node scripts/content/exercise-dataset.mjs --check",
    "content:wger-exercises": "node scripts/content/wger-exercises.mjs --from-review",
    "content:wger-exercises:check": "node scripts/content/wger-exercises.mjs --check",
    "content:videos": "node scripts/content/exercise-videos.mjs",
    "test:organization-nutrition": "node scripts/prisma/isolated-api.mjs tests/organization-nutrition.test.ts",
    "test:organization-assets": "node scripts/prisma/isolated-api.mjs tests/organization-assets.test.ts",
    "test:organization-feedback": "node scripts/prisma/isolated-api.mjs tests/organization-feedback.test.ts",
    "test:organization-sports": "node scripts/prisma/isolated-api.mjs tests/organization-sports.test.ts",
    "test:coaching-team": "node scripts/prisma/isolated-api.mjs tests/coaching-team.test.ts",
    "test:concurrent-plans": "node scripts/prisma/isolated-api.mjs tests/concurrent-plans.test.ts",
    "test:delegated-sessions": "node scripts/prisma/isolated-api.mjs tests/delegated-sessions.test.ts",
    "test:organization-injuries": "node scripts/prisma/isolated-api.mjs tests/organization-injuries.test.ts",
    "test:injury-retention-scheduler": "node scripts/prisma/isolated-api.mjs tests/organization-injury-retention-scheduler.test.ts",
    "test:institution-cleanup": "node scripts/prisma/verify-institution-cleanup.mjs",
    "test:workout-foundation": "node scripts/prisma/verify-workout-foundation.mjs",
    "test:workout-sequence": "node scripts/prisma/isolated-api.mjs tests/workout-sequence.test.ts",
    "inventory": "node scripts/backend-inventory.mjs",
    "inventory:check": "node scripts/backend-inventory.mjs --check",
    "inventory:database": "node scripts/backend-inventory.mjs --refresh-database",
    "test:institution-names": "node scripts/prisma/verify-institution-names.mjs",
    "test:institution-api": "node scripts/prisma/isolated-api.mjs tests/retired-domains.test.ts tests/backend-boundary.test.ts tests/institution-transport.test.ts",
    "test:retired-domains": "node scripts/prisma/verify-retired-domains.mjs",
    "test:workout-scheduler": "node scripts/prisma/isolated-api.mjs tests/workout-scheduler.test.ts",
    "workouts:prepare": "tsx scripts/prepare-workouts.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rafik/shared": "1.0.0-beta.2",
    "pg": "8.16.3",
    "prisma": "7.10.1",
    "swagger-ui-dist": "5.33.3",
    "tsx": "4.20.6"
  }
}
