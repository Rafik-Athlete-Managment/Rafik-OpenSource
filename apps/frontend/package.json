{
  "name": "@rafik/frontend",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/isolated-browser.mjs",
    "format": "prettier --write src tests build *.ts",
    "format:check": "prettier --check src tests build *.ts",
    "test:build": "node --experimental-strip-types scripts/check-shell-build.mjs",
    "test:e2e:running": "playwright test",
    "test:operations:layout": "node scripts/isolated-browser.mjs operations.e2e.ts",
    "test:cohesion:layout": "node scripts/isolated-browser.mjs cohesion.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@phosphor-icons/vue": "2.2.1",
    "@rafik/shared": "1.0.0-beta.2",
    "@unovis/ts": "1.7.0",
    "@unovis/vue": "1.7.0",
    "idb": "8.0.3",
    "reka-ui": "2.10.5",
    "sweetalert2": "^11.26.25",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.11"
  }
}
